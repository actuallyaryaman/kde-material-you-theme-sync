def hex2rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def rgb2hex(rgb):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(c))) for c in rgb)


PALETTE_KEYS = ("bg", "surface0", "surface1", "hover", "fg", "fg_window", "fg_muted",
                "accent", "accent_hover", "accent_fg",
                "red", "green", "yellow", "blue", "magenta", "cyan", "wm", "frame")


def palette_swatch(p):
    return " ".join(f"\033[38;2;{'{};{};{}'.format(*hex2rgb(p[k]))}m██\033[0m" for k in PALETTE_KEYS)


def mix(a, b, t):
    return rgb2hex(tuple(x + (y - x) * t for x, y in zip(hex2rgb(a), hex2rgb(b))))


def parse_wm_bg(val):
    val = val.strip()
    if val.startswith("#"):
        return "#" + val[1:][-6:]
    return rgb2hex(tuple(int(x) for x in val.split(",")[:3]))


def read_knobs():
    k = {"scale": DEFAULT_SCALE, "override": ""}
    try:
        with open(KNOBS) as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if not line or "=" not in line:
                    continue
                key, _, val = line.partition("=")
                k[key.strip()] = val.strip()
        k["scale"] = float(k["scale"])
    except Exception:
        pass
    return k


def frame_for(wm):
    over = os.environ.get("THEME_SYNC_FRAME")
    if over:
        return over.strip()
    k = read_knobs()
    if k["override"]:
        return k["override"]
    return mix(wm, "#000000", 1 - k["scale"])


def read_scheme(path):
    cp = ConfigParser(interpolation=None)
    with open(path) as f:
        cp.read_file(f)
    sec = lambda s: cp[s]
    g = lambda d, k: d[k.lower()]
    V, W, S, B = sec("Colors:View"), sec("Colors:Window"), sec("Colors:Selection"), sec("Colors:Button")
    p = dict(
        bg=g(V, "BackgroundNormal"),
        surface0=g(W, "BackgroundNormal"),
        surface1=g(B, "BackgroundAlternate"),
        hover=g(V, "DecorationHover"),
        fg=g(V, "ForegroundNormal"),
        fg_window=g(W, "ForegroundNormal"),
        fg_muted=g(V, "ForegroundInactive"),
        accent=g(S, "BackgroundNormal"),
        accent_hover=g(S, "DecorationHover"),
        accent_fg=g(S, "ForegroundNormal"),
        red=g(V, "ForegroundNegative"),
        green=g(V, "ForegroundPositive"),
        yellow=g(V, "ForegroundNeutral"),
        blue=g(V, "ForegroundLink"),
        magenta=g(V, "ForegroundVisited"),
    )
    p["cyan"] = mix(p["blue"], p["green"], 0.5)
    p["wm"] = parse_wm_bg(cp.get("WM", "activebackground", fallback=p["bg"]))
    p["frame"] = frame_for(p["wm"])
    return p


def active_scheme():
    cp = ConfigParser(interpolation=None)
    cp.read(os.path.expanduser("~/.config/kdeglobals"))
    name = cp.get("General", "ColorScheme", fallback="")
    if name:
        p = os.path.join(SCHEMES, name + ".colors")
        if os.path.exists(p):
            return p, name
    for cand in ("MaterialYouDark.colors", "MaterialYouLight.colors"):
        p = os.path.join(SCHEMES, cand)
        if os.path.exists(p):
            return p, cand
    sys.exit("No KDE Material You scheme found in " + SCHEMES)


