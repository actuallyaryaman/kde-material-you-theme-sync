def gen_vicinae(p):
    h = lambda c: c[1:] if c.startswith("#") else c
    sel = mix(p["accent"], p["frame"], 0.25)
    return f"""# Generated by theme-sync. Re-run theme-sync to regenerate.
[meta]
version = 1
name = "Material You"
description = "Generated from the KDE Material You color scheme"
