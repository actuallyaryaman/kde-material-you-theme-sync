def gen_fastfetch(p):
    try:
        with open(FASTFETCH) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        cfg = json.loads(json.dumps(DEFAULT_FASTFETCH))
    cfg["colors"] = {
        "title": p["accent"],
        "keys": p["blue"],
        "dots": p["fg"],
        "section": p["accent"],
        "danger": p["red"],
        "warning": p["yellow"],
        "success": p["green"],
    }
    cfg.setdefault("display", {}).setdefault("color", {})["separator"] = p["fg_muted"]
    return json.dumps(cfg, indent=4) + "\n"


def obsidian_block(name, p):
    r, g, b = hex2rgb(p["accent"])
    return f""".theme-{name} {{
  --color-base-00: {p['bg']};
  --color-base-10: {p['surface0']};
  --color-base-20: {p['surface0']};
  --color-base-25: {p['surface1']};
  --color-base-30: {mix(p['surface1'], p['fg'], 0.06)};
  --color-base-35: {p['hover']};
  --color-base-40: {p['fg_muted']};
  --color-base-50: {p['fg_muted']};
  --color-base-60: {p['fg_window']};
  --color-base-70: {p['fg_window']};
  --color-base-100: {p['fg']};
  --text-normal: {p['fg']};
  --text-muted: {p['fg_muted']};
  --text-faint: {p['fg_muted']};
  --interactive-accent: {p['accent']};
  --interactive-accent-hover: {p['accent_hover']};
  --interactive-accent-rgb: {r}, {g}, {b};
  --text-on-accent: {p['accent_fg']};
}}
"""


def check_deps():
    plasmoid = "/usr/share/plasma/plasmoids/luisbocanegra.kdematerialyou.colors"
    user_plasmoid = os.path.expanduser("~/.local/share/plasma/plasmoids/luisbocanegra.kdematerialyou.colors")
    if not (os.path.isdir(plasmoid) or os.path.isdir(user_plasmoid)):
        sys.exit("missing KDE Material You widget: install luisbocanegra/kde-material-you-colors "
                 "(https://github.com/luisbocanegra/kde-material-you-colors) first")
    if subprocess.run(["which", "kde-material-you-colors"], capture_output=True).returncode != 0:
        sys.exit("kde-material-you-colors binary not in PATH: install luisbocanegra/kde-material-you-colors first")
    if subprocess.run(["pgrep", "-f", "kde-material-you-colors"], capture_output=True).returncode != 0:
        sys.exit("kde-material-you-colors daemon not running: add the widget to your panel/desktop and enable it")
    for scheme in ("MaterialYouDark.colors", "MaterialYouLight.colors"):
        if not os.path.exists(os.path.join(SCHEMES, scheme)):
            sys.exit(f"missing source scheme {scheme}: let the KDE Material You widget generate it from your wallpaper")


def main():
    if sys.argv[1:] and sys.argv[1] in ("--check", "-c"):
        return check()
    check_deps()
    active = sys.argv[1] if sys.argv[1:] and not sys.argv[1].startswith("-") else None
    if active:
        name = os.path.basename(active)
    else:
        active, name = active_scheme()
    dark = read_scheme(os.path.join(SCHEMES, "MaterialYouDark.colors"))
    light = read_scheme(os.path.join(SCHEMES, "MaterialYouLight.colors"))
    pal = dark if "MaterialYouDark" in name else light
    print("frame (titlebar):", pal["frame"])
    print("palette:", palette_swatch(pal))

    with open(ALACRITTY, "w") as f:
        f.write(gen_alacritty(pal))
    os.makedirs(os.path.dirname(OPENCODE), exist_ok=True)
    with open(OPENCODE, "w") as f:
        f.write(gen_opencode(dark, light))
    os.makedirs(os.path.dirname(OBSIDIAN), exist_ok=True)
    with open(OBSIDIAN, "w") as f:
        f.write("/* Generated by theme-sync. Re-run theme-sync after changing wallpaper. */\n")
        f.write(obsidian_block("dark", dark))
        f.write("\n")
        f.write(obsidian_block("light", light))
    os.makedirs(os.path.dirname(BTOP), exist_ok=True)
    with open(BTOP, "w") as f:
        f.write(gen_btop(pal))
    with open(FASTFETCH, "w") as f:
        f.write(gen_fastfetch(pal))
    os.makedirs(os.path.dirname(VICINAE), exist_ok=True)
    with open(VICINAE, "w") as f:
        f.write(gen_vicinae(pal))
    os.makedirs(os.path.dirname(QBITTORRENT), exist_ok=True)
    with open(QBITTORRENT, "w") as f:
        f.write(gen_qbittorrent(pal))
    set_qbit_theme(pal)
    set_vscodium_theme(pal)
    print(f"synced from {name}:")
    print(f"  alacritty → {ALACRITTY}")
    print(f"  opencode  → {OPENCODE}")
    print(f"  obsidian  → {OBSIDIAN}")
    print(f"  btop      → {BTOP}")
    print(f"  fastfetch → {FASTFETCH}")
    print(f"  vicinae   → {VICINAE}")
    print(f"  qbittorrent → {QBITTORRENT}")
    print(f"  vscodium    → {VSCODIUM_THEME}")
    check()
    subprocess.run(["systemctl", "--user", "restart", "vicinae"], check=True, capture_output=True)
    print("restarted vicinae daemon")
    if subprocess.run(["pgrep", "-x", "qbittorrent"], capture_output=True).returncode == 0:
        subprocess.run(["killall", "qbittorrent"], capture_output=True)
        subprocess.Popen(["qbittorrent"], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("restarted qbittorrent")
    if subprocess.run(["pgrep", "-x", "codium"], capture_output=True).returncode == 0:
        subprocess.run(["killall", "codium"], capture_output=True)
        subprocess.Popen(["codium"], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("restarted codium")


def set_qbit_theme(p):
    conf = ""
    try:
        with open(QBIT_CONF) as f:
            conf = f.read()
    except OSError:
        pass
    path = re.sub(r"^General\\CustomUIThemePath=.*$", lambda m: "General\\CustomUIThemePath=" + QBITTORRENT, conf, flags=re.M)
    path = re.sub(r"^General\\UseCustomUITheme=.*$", lambda m: "General\\UseCustomUITheme=true", path, flags=re.M)
    with open(QBIT_CONF, "w") as f:
        f.write(path)


def set_vscodium_theme(p):
    theme = gen_vscodium(p)
    is_dark = theme["type"] == "dark"
    pkg = {
        "name": "material-you-theme",
        "displayName": "Material You",
        "description": "Material You color theme generated by theme-sync.",
        "version": "1.0.0",
        "publisher": "theme-sync",
        "engines": {"vscode": "^1.70.0"},
        "categories": ["Themes"],
        "contributes": {
            "themes": [{"label": "Material You", "uiTheme": "vs-dark" if is_dark else "vs-light", "path": "./themes/material-you-color-theme.json"}]
        },
    }
    os.makedirs(os.path.dirname(VSCODIUM_THEME), exist_ok=True)
    with open(VSCODIUM_THEME, "w") as f:
        json.dump(theme, f, indent=4)
        f.write("\n")
    with open(VSCODIUM_PKG, "w") as f:
        json.dump(pkg, f, indent=4)
        f.write("\n")
    try:
        with open(VSCODIUM) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        cfg = {}
    cfg.pop("workbench.colorCustomizations", None)
    cfg["workbench.colorTheme"] = "Material You"
    with open(VSCODIUM, "w") as f:
        json.dump(cfg, f, indent=4)
        f.write("\n")


def check():
    _, name = active_scheme()
    accent = read_scheme(os.path.join(SCHEMES, name + ".colors"))["accent"]
    dark_accent = read_scheme(os.path.join(SCHEMES, "MaterialYouDark.colors"))["accent"]
    with open(ALACRITTY) as f:
        a = f.read()
    match = re.search(r"^background = '([^']+)'", a, re.M)
    assert match, "alacritty theme missing header"
    a_bg = match.group(1)
    with open(OPENCODE) as f:
        o = json.load(f)
    key = "dark" if "Dark" in name else "light"
    oc_bg = o["theme"]["background"][key]
    with open(OBSIDIAN) as f:
        obs = f.read()
    with open(BTOP) as f:
        bt = f.read()
    m = re.search(r"^theme\[main_bg\]=\"#([0-9a-fA-F]{6})\"", bt, re.M)
    assert m, "btop theme missing main_bg"
    bt_bg = "#" + m.group(1)
    with open(FASTFETCH) as f:
        ff = json.load(f)
    with open(VICINAE) as f:
        vi = f.read()
    vm = re.search(r"^background = \"#([0-9a-fA-F]{6})\"", vi, re.M)
    assert vm, "vicinae theme missing background"
    vi_bg = "#" + vm.group(1)
    assert a_bg == oc_bg == bt_bg == vi_bg, f"terminal backgrounds diverge: {a_bg} {oc_bg} {bt_bg} {vi_bg}"
    assert accent in a, "alacritty accent out of sync"
    assert o["theme"]["primary"]["dark"] == dark_accent, "opencode theme out of sync"
    assert ".theme-dark" in obs and ".theme-light" in obs and accent in obs, "obsidian theme out of sync"
    assert f"theme[title]=\"#{accent[1:]}\"" in bt, "btop theme out of sync"
    assert ff["colors"]["title"] == accent, "fastfetch theme out of sync"
    assert f"accent = \"#{accent[1:]}\"" in vi, "vicinae theme out of sync"
    with open(QBITTORRENT) as f:
        qb = json.load(f)
    assert qb["colors"]["Palette.Highlight"] == accent, "qbittorrent theme out of sync"
    with open(QBIT_CONF) as f:
        qconf = f.read()
    assert "General\\UseCustomUITheme=true" in qconf and QBITTORRENT in qconf, "qbittorrent conf not pointing at theme"
    with open(VSCODIUM) as f:
        vsc = json.load(f)
    assert vsc.get("workbench.colorTheme") == "Material You", "vscodium not using Material You theme"
    assert "workbench.colorCustomizations" not in vsc, "vscodium still has stale colorCustomizations"
    with open(VSCODIUM_THEME) as f:
        vt = json.load(f)
    assert vt["colors"]["editor.background"] == a_bg, "vscodium theme out of sync"
    assert any(r.get("settings", {}).get("foreground") == accent for r in vt["tokenColors"]), "vscodium theme accent missing"
    print(f"check ok: all 8 themes match {name} ({accent}); shared bg {a_bg}")


if __name__ == "__main__":
    main()