def oc(p):
    add = mix(p["frame"], p["green"], 0.15)
    rem = mix(p["frame"], p["red"], 0.15)
    return dict(
        primary=p["accent"], secondary=p["fg_window"], accent=p["accent"],
        error=p["red"], warning=p["yellow"], success=p["green"], info=p["blue"],
        text=p["fg"], textMuted=p["fg_muted"],
        background=p["frame"], backgroundPanel=p["frame"],
        backgroundElement=p["surface0"],
        border=p["surface0"], borderActive=p["accent"], borderSubtle=p["surface0"],
        diffAdded=p["green"], diffRemoved=p["red"], diffContext=p["fg_muted"],
        diffHunkHeader=p["accent"], diffHighlightAdded=p["green"],
        diffHighlightRemoved=p["red"], diffAddedBg=add, diffRemovedBg=rem,
        diffContextBg=p["frame"], diffLineNumber=p["fg_muted"],
        diffAddedLineNumberBg=add, diffRemovedLineNumberBg=rem,
        markdownText=p["fg"], markdownHeading=p["accent"], markdownLink=p["blue"],
        markdownLinkText=p["blue"], markdownCode=p["green"],
        markdownBlockQuote=p["fg_window"], markdownEmph=p["yellow"],
        markdownStrong=p["fg"], markdownHorizontalRule=p["fg_muted"],
        markdownListItem=p["yellow"], markdownListEnumeration=p["yellow"],
        markdownImage=p["blue"], markdownImageText=p["blue"],
        markdownCodeBlock=p["fg_muted"],
        syntaxComment=p["fg_muted"], syntaxKeyword=p["accent"],
        syntaxFunction=p["blue"], syntaxVariable=p["yellow"],
        syntaxString=p["green"], syntaxNumber=p["magenta"],
        syntaxType=p["fg_window"], syntaxOperator=p["accent"],
        syntaxPunctuation=p["fg_window"],
    )


def gen_opencode(dark, light):
    d, l = oc(dark), oc(light)
    theme = {k: {"dark": d[k], "light": l[k]} for k in d}
    return json.dumps({"$schema": "https://opencode.ai/theme.json",
                       "theme": theme}, indent=2) + "\n"


