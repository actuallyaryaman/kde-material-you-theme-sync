        "editorBracketHighlight.foreground3": "#31C193",
        "editorBracketHighlight.foreground4": "#FA9A24",
        "editorBracketHighlight.foreground5": "#B489F3",
        "editorBracketHighlight.foreground6": "#3bb4b2",
        "editorBracketHighlight.unexpectedBracket.foreground": "#FF7352",
        "editorIndentGuide.background1": "#1d2827",
        "editorIndentGuide.activeBackground1": "#6d7877",
