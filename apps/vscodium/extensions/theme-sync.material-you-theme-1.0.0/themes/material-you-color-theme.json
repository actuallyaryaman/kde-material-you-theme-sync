        "breadcrumb.foreground": "#6d7877",
        "breadcrumb.activeSelectionForeground": "#dce8e7",
        "breadcrumb.focusForeground": "#98cdcc",
        "breadcrumbPicker.background": "#131b1b",
        "settings.headerForeground": "#dce8e7",
        "settings.modifiedItemIndicator": "#98cdcc",
        "settings.checkboxBackground": "#131b1b",
        "settings.checkboxForeground": "#dce8e7",
        "settings.checkboxBorder": "#1d2827",
        "settings.textInputBackground": "#111817",
        "settings.textInputForeground": "#dce8e7",
        "settings.textInputBorder": "#1d2827",
