        "settings.dropdownListBorder": "#1d2827",
        "settings.rowHoverBackground": "#232b2b",
        "settings.focusedRowBackground": "#232b2b"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#6d7877",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#98cdcc"
            }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.logical",
                "punctuation.accessor"
            ],
            "settings": {
                "foreground": "#a2adad"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.template",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#31C193"
            }
        },
        {
            "name": "Escape",
            "scope": [
                "constant.character.escape",
                "string.escape"
            ],
            "settings": {
                "foreground": "#3bb4b2"
            }
        },
        {
            "name": "Regex",
            "scope": [
                "string.regexp",
                "constant.character.character-class"
            ],
            "settings": {
                "foreground": "#B489F3"
            }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.other"
            ],
            "settings": {
                "foreground": "#FA9A24"
            }
        },
        {
            "name": "Constant language",
            "scope": [
                "constant.language",
                "constant.rgb-value",
                "constant.other.color"
            ],
            "settings": {
                "foreground": "#FA9A24"
            }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "support.constant.handlebars",
                "entity.name.operator.custom-literal"
            ],
            "settings": {
                "foreground": "#45A8D2"
            }
        },
        {
            "name": "Types",
            "scope": [
                "support.class",
                "support.type",
                "entity.name.type",
                "entity.name.namespace",
                "entity.other.inherited-class",
                "entity.name.class",
                "entity.name.scope-resolution"
            ],
            "settings": {
                "foreground": "#3bb4b2"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "meta.definition.variable.name",
                "support.variable",
                "entity.name.variable"
            ],
            "settings": {
                "foreground": "#dce8e7"
            }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#dce8e7"
            }
        },
        {
            "name": "Object keys",
            "scope": [
                "meta.object-literal.key",
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.media-type"
            ],
            "settings": {
                "foreground": "#45A8D2"
            }
        },
        {
            "name": "Enum members",
            "scope": [
                "variable.other.constant",
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#FA9A24"
            }
        },
        {
            "name": "PP / preprocessor",
            "scope": [
                "preprocessor",
                "keyword.control.import",
                "keyword.control.package"
            ],
            "settings": {
                "foreground": "#B489F3"
            }
        },
        {
            "name": "Tags",
            "scope": [
                "entity.name.tag"
            ],
            "settings": {
                "foreground": "#FF7352"
            }
        },
        {
            "name": "Attributes",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#FA9A24"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.delimiter"
            ],
            "settings": {
                "foreground": "#a2adad"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#FF7352",
                "fontStyle": "underline"
            }
        },
        {
            "name": "Markdown heading",
            "scope": [
                "markup.heading"
            ],
            "settings": {
                "foreground": "#98cdcc",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown bold",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#dce8e7",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown italic",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#dce8e7",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markdown links",
            "scope": [
                "markup.underline.link",
                "constant.other.reference.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#45A8D2",
                "fontStyle": "underline"
            }
        },
        {
            "name": "Markdown quote",
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "foreground": "#6d7877",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markdown raw",
            "scope": [
                "markup.raw.inline",
                "markup.inline.raw"
            ],
            "settings": {
                "foreground": "#31C193"
            }
        },
        {
            "name": "Markdown list",
            "scope": [
                "markup.list"
            ],
            "settings": {
                "foreground": "#98cdcc"
            }
        },
        {
            "name": "Diff added",
            "scope": [
                "markup.inserted"
            ],
            "settings": {
                "foreground": "#31C193"
            }
        },
        {
            "name": "Diff deleted",
            "scope": [
                "markup.deleted"
            ],
            "settings": {
                "foreground": "#FF7352"
            }
        },
        {
            "name": "CSS property",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name",
                "support.constant.property-value"
            ],
            "settings": {
                "foreground": "#98cdcc"
            }
        },
        {
            "name": "CSS class",
            "scope": [
                "entity.other.attribute-name.class",
                "entity.name.tag.css"
            ],
            "settings": {
                "foreground": "#45A8D2"
            }
        },
        {
            "name": "Sass variable",
            "scope": [
                "variable.other.scss",
                "variable.scss",
                "variable.other.less"
            ],
            "settings": {
                "foreground": "#B489F3"
            }
        },
        {
            "name": "JSX/TSX tag",
            "scope": [
                "punctuation.definition.tag.begin.js",
                "punctuation.definition.tag.end.js",
                "meta.tag.sgml"
            ],
            "settings": {
                "foreground": "#6d7877"
            }
        },
        {
            "name": "Python decorator",
            "scope": [
                "entity.name.function.decorator",
                "keyword.control.decorator"
            ],
            "settings": {
                "foreground": "#B489F3"
            }
        },
        {
            "name": "Function call support",
            "scope": [
                "support.function.any-method",
                "meta.function-call",
                "punctuation.definition.function-call"
            ],
            "settings": {
                "foreground": "#dce8e7"
            }
        }
    ],
    "semanticTokenColors": {
        "comment": {
            "foreground": "#6d7877",
            "fontStyle": "italic"
        },
        "string": {
            "foreground": "#31C193"
        },
        "number": {
            "foreground": "#FA9A24"
        },
        "boolean": {
            "foreground": "#FA9A24"
        },
        "keyword": {
            "foreground": "#98cdcc"
        },
        "operator": {
            "foreground": "#a2adad"
        },
        "property": {
            "foreground": "#45A8D2"
        },
        "parameter": {
            "foreground": "#dce8e7"
        },
        "variable": {
            "foreground": "#dce8e7"
        },
        "function": {
            "foreground": "#45A8D2"
        },
        "method": {
            "foreground": "#45A8D2"
        },
        "type": {
            "foreground": "#3bb4b2"
        },
        "class": {
            "foreground": "#3bb4b2"
        },
        "interface": {
            "foreground": "#3bb4b2"
        },
        "enum": {
            "foreground": "#FA9A24"
        },
        "enumMember": {
            "foreground": "#FA9A24"
        },
        "namespace": {
            "foreground": "#3bb4b2"
        },
        "decorator": {
            "foreground": "#B489F3"
        },
        "macro": {
            "foreground": "#B489F3"
        },
        "event": {
            "foreground": "#45A8D2"
        },
        "typeParameter": {
            "foreground": "#3bb4b2"
        },
        "label": {
            "foreground": "#6d7877"
        },
        "regexp": {
            "foreground": "#B489F3"
        },
        "escapeCharacter": {
            "foreground": "#3bb4b2"
        },
        "modifier": {
            "foreground": "#98cdcc"
        }
    }
}
